# ─────────────────────────────────────────────────────────────
# 开发环境（vite dev 默认 mode）
# 变量须在 src/env.d.ts 同步声明类型
# ─────────────────────────────────────────────────────────────

# 运行环境标识
VITE_APP_ENV=development

# 应用标题（index.html 与顶栏共用）
VITE_APP_TITLE=OCS 斯摩棱斯克 · 开发版

# API 基地址；本期无后端留空，二期 FastAPI 服务部署时填写
VITE_API_BASE_URL=