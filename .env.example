# ─────────────────────────────────────────────────────────────
# 环境变量示例：复制为 .env.local 可逐项覆盖（.env.local 不入库）
# 新增键时：① 补 .env.development / .env.production 默认值
#           ② 在 src/env.d.ts 声明类型
# ─────────────────────────────────────────────────────────────

# 运行环境标识（development | production | test）
VITE_APP_ENV=development

# 应用标题
VITE_APP_TITLE=OCS 斯摩棱斯克

# API 基地址；本期无后端留空，二期 FastAPI 服务部署时填写
VITE_API_BASE_URL=