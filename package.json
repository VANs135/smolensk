{
  "name": "smolensk-ocs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OCS 斯摩棱斯克兵棋推演程序（Smolensk: Barbarossa Derailed 电子裁判台）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "serve:dist": "node scripts/serve-dist.mjs",
    "pack": "npm run build && node scripts/pack-release.mjs",
    "android:sync": "npm run build && cap sync android",
    "android:apk": "npm run android:sync && node scripts/android-apk.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "perf:compare": "node scripts/perf-compare.mjs",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --exclude \"tests/flows/ai-selfplay.test.ts\"",
    "test:watch": "vitest",
    "test:fast": "vitest run --exclude \"tests/flows/ai-*.test.ts\" --exclude \"tests/flows/*selfplay*.test.ts\"",
    "test:ai": "vitest run tests/flows/ai- tests/flows/intro-selfplay tests/flows/intro-air-selfplay",
    "test:selfplay": "vitest run tests/flows/ai-selfplay.test.ts",
    "arch": "node scripts/check-arch.mjs",
    "tdz": "node scripts/check-tdz.mjs",
    "gen:counters": "node scripts/gen-counter-data.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run audit:ports && npm run audit:clauses && npm run tdz && npm run gen:counters -- --check && npm run test:fast && npm run arch",
    "check:all": "npm run lint && npm run format:check && npm run typecheck && npm run audit:ports && npm run tdz && npm run gen:counters -- --check && npm run test && npm run arch",
    "audit:ports": "node scripts/port-tdz-audit.mjs",
    "audit:clauses": "node scripts/audit-clause-prefix.mjs --fail"
  },
  "dependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/core": "^7.6.10",
    "pinia": "^3.0.1",
    "vue": "^3.5.13",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.10",
    "@eslint/js": "^9.17.0",
    "@rolldown/binding-win32-x64-msvc": "1.2.8",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^22.10.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "sharp": "^0.35.5",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.11",
    "vue-tsc": "^2.2.0"
  }
}
